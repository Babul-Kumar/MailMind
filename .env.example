# ==============================================================================
# MailMind Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your environment.
# NEVER commit real credentials, OAuth client secrets, or private keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT [REQUIRED]
# ------------------------------------------------------------------------------
# Defines execution environment mode: 'development' or 'production'.
# In 'production':
#   - Cookies are enforced with Secure=True (requires HTTPS)
#   - Test session endpoints (/api/auth/test-session) are strictly disabled
#   - Debug error traces are suppressed
# Values: 'development' | 'production'
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. APPLICATION BASE URL (BACKEND URL) [REQUIRED IN PRODUCTION]
# ------------------------------------------------------------------------------
# The fully-qualified public URL of the FastAPI backend application.
# Used to construct the exact Google OAuth 2.0 redirect_uri callback.
# On Render, set this to your Render service URL (e.g., https://mailmind.onrender.com).
# In local development, if omitted it defaults to request host (http://127.0.0.1:8000).
# Example: https://mailmind.onrender.com
BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2b. FRONTEND APPLICATION URL [REQUIRED FOR SPLIT VERCEL DEPLOYMENT]
# ------------------------------------------------------------------------------
# In a split production deployment (Vercel Frontend + Render Backend):
# Set this to the public URL of your Vercel frontend (e.g. https://mailmind.vercel.app).
# When configured:
#   - Automatically added to backend CORS whitelist (ALLOWED_ORIGINS)
#   - Google OAuth callback redirects the user back to this URL on successful login
# In local monolithic development: defaults to "/"
# FRONTEND_URL=https://mailmind.vercel.app

# ------------------------------------------------------------------------------
# 3. SERVER BINDING & NETWORKING [OPTIONAL / INJECTED BY RENDER]
# ------------------------------------------------------------------------------
# Network host address for FastAPI/Uvicorn server.
# Default: 127.0.0.1 (local loopback), use 0.0.0.0 for containerized/Render deployment.
HOST=127.0.0.1

# Network port for backend server.
# Render automatically injects the PORT environment variable (e.g., 10000).
# Default: 8000
PORT=8000

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 CREDENTIALS [REQUIRED FOR GMAIL INTEGRATION]
# ------------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials:
# Create an OAuth 2.0 Client ID with Type: "Web application".
# Authorized redirect URI:
#   http://127.0.0.1:8000/api/auth/callback (development)
#   https://your-service.onrender.com/api/auth/callback (production)
#
# Provide credentials using ONE of the three methods below (evaluated in priority order):
#
# Method A: Discrete Environment Variables (Recommended for Render)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
#
# Method B: Full JSON String in Environment Variable (Alternative for Render)
# GOOGLE_OAUTH_CLIENT_JSON={"web":{"client_id":"...","client_secret":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}
#
# Method C: File Path (Render Secret File or Local Development)
# By default, checks 'google_auth/credentials.json'. Override with:
# CREDENTIALS_PATH=/etc/secrets/credentials.json
# or standard GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/credentials.json

# ------------------------------------------------------------------------------
# 5. PERSISTENT DATA DIRECTORY [OPTIONAL / RECOMMENDED FOR RENDER DISK]
# ------------------------------------------------------------------------------
# Directory path where user sessions and SQLite mailbox caches are stored.
# In local development: defaults to 'google_auth/' (ignored by git).
# On Render: Attach a Persistent Disk (e.g. /var/data) and set DATA_DIR to persist
# user sessions and cached email metadata across deploys and container restarts.
# DATA_DIR=/var/data

# ------------------------------------------------------------------------------
# 6. CORS ALLOWED ORIGINS [OPTIONAL]
# ------------------------------------------------------------------------------
# Comma-separated list of additional allowed origins for CORS.
# Default includes localhost:3000, 5173, 8000, 127.0.0.1.
# BASE_URL is automatically added to allowed origins if set.
# ALLOWED_ORIGINS=https://mailmind.onrender.com,https://custom-domain.com

# ------------------------------------------------------------------------------
# 7. SESSION SECURITY & CRYPTOGRAPHY [OPTIONAL]
# ------------------------------------------------------------------------------
# Secret key used for cryptographic session signing and state hashing.
# In production, use a strong 256-bit random hex/base64 string.
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-32-byte-random-session-secret-here

# Cookie SameSite attribute: 'lax', 'strict', or 'none'.
# In split deployment (Vercel on different domain from Render), cross-origin
# fetch requests require COOKIE_SAMESITE=none with Secure=True.
# Defaults to 'none' in production and 'lax' in development.
# COOKIE_SAMESITE=none

# ------------------------------------------------------------------------------
# 8. TESTING & CI OVERRIDES [DEVELOPMENT / TEST ONLY]
# ------------------------------------------------------------------------------
# Explicitly enables/disables offline test session creation (/api/auth/test-session).
# In production, this variable defaults to 'false' and cannot be enabled unless
# explicitly set to 'true' for controlled integration test harnesses.
# Values: 'true' | 'false'
ALLOW_TEST_ENDPOINTS=false
