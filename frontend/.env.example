# ==============================================================================
# MailMind Frontend Environment Configuration Template (.env.example)
# Copy this file to .env.local for local frontend development if needed.
# For Vercel production: Add VITE_API_BASE_URL in Vercel Project Settings > Environment Variables.
#
# CRITICAL SECURITY NOTE:
# Variables prefixed with VITE_ are embedded into public client-side JavaScript.
# NEVER put client secrets, API private keys, or passwords into VITE_ variables!
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND API BASE URL [REQUIRED IN PRODUCTION]
# ------------------------------------------------------------------------------
# The fully-qualified public HTTPS URL of your Render FastAPI backend.
#
# Production (Vercel):
#   Set this in Vercel dashboard to your Render backend URL:
#   VITE_API_BASE_URL=https://your-mailmind-backend.onrender.com
#
# Local Development:
#   Can be left empty or unset to automatically use the Vite dev proxy (http://127.0.0.1:8000).
#   VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=https://your-mailmind-backend.onrender.com
